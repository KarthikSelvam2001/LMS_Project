{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "dev": "concurrently \"tsx artifacts/api-server/src/index.ts\" \"vite artifacts/lms-frontend --host 0.0.0.0\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ]
}